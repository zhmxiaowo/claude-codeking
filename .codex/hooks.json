{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/scripts/block-dangerous-cmd.js"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/scripts/pre-write-context7-check.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*context7.*",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/scripts/track-context7-query.js"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/scripts/session-start-inject.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/scripts/context-compact-warn.js"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/scripts/work-continuation.js"
          }
        ]
      }
    ]
  }
}
